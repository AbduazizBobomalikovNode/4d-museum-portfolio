# Renderer backend: "webgl" (default, stable) | "webgpu" (experimental, R3F v9 async gl factory)
VITE_RENDERER=webgl
# Show Leva debug panel: "1" to force on
VITE_DEBUG=0

# ── Fikr formasi (About xonasidagi 3D forma) ──────────────────────────
# TAVSIYA: serverless relay — token serverda qoladi (api/feedback.js):
#   # Vercel'da bu qiymat vercel.json dagi buildCommand orqali beriladi (/api/feedback),
# va TG_BOT_TOKEN / TG_CHAT_ID dashboard'ning Environment Variables bo'limida turadi —
# server tomonda, bundle'ga tushmaydi. Batafsil: docs/DEPLOY.md
VITE_FEEDBACK_ENDPOINT=/api/feedback
# Faqat lokal test uchun (DIQQAT: VITE_* qiymatlari public bundle'ga tushadi,
# ya'ni saytni ochgan har kim tokenni o'qiy oladi):
#   VITE_TG_BOT_TOKEN=<bot_token_from_@BotFather>
#   VITE_TG_CHAT_ID=<your_chat_id>
VITE_FEEDBACK_ENDPOINT=
